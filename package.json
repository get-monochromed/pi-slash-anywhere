  "description": "Trigger slash commands, prompt templates, and skills anywhere inline in prompt messages with smart autocomplete and zero-friction expansion.",
  "type": "module",
  "main": "extensions/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/toRolex/pi-slash-anywhere.git"
  },
  "homepage": "https://github.com/toRolex/pi-slash-anywhere#readme",
  "bugs": {
    "url": "https://github.com/toRolex/pi-slash-anywhere/issues"
  },
  "author": "toRolex",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "slash-commands",
    "autocomplete",
    "skills"
  ],
  "scripts": {
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
